<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Clean up after cards in board 2's Done lane: stop the test server, close the
     agent tab and the card's own workspace, remove the worktree (branch stays).
     Install: cp to ~/Library/LaunchAgents/ and `launchctl bootstrap gui/$(id -u) <path>`. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.herdr-board.done-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/martin/Code/herdr-board-done-cleanup/scripts/done-cleanup.sh</string>
    <string>--board</string><string>2</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- python3 (homebrew), board and herdr (~/.local/bin), lsof (/usr/sbin) -->
    <key>PATH</key><string>/opt/homebrew/bin:/Users/martin/.local/bin:/usr/bin:/bin:/usr/sbin</string>
  </dict>
  <!-- Every 60 seconds, and once at login. -->
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/martin/.local/share/herdr-board/done-cleanup.log</string>
  <key>StandardErrorPath</key><string>/Users/martin/.local/share/herdr-board/done-cleanup.log</string>
</dict>
</plist>
